{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@poll-automation/types": ["../../../shared/types/src/index"],
      "@poll-automation/types/*": ["../../../shared/types/src/*"]
    }
  },
  "include": ["src", "../../../shared/types/src"],
  "exclude": ["node_modules", "dist"]
}